// Catalogo multi-gioco: Game -> CardSet -> Card -> Listing.
// Un Listing e' cio' che si compra: carta singola, prodotto sigillato o carta gradata.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Game {
  id        String    @id @default(cuid())
  slug      String    @unique // "pokemon", "one-piece"
  name      String
  active    Boolean   @default(true)
  sets      CardSet[]
  listings  Listing[]
  createdAt DateTime  @default(now())
}

model CardSet {
  id          String    @id @default(cuid())
  gameId      String
  game        Game      @relation(fields: [gameId], references: [id])
  externalId  String? // id nella vecchia Pokémon TCG API (es. "sv3pt5"), tenuto per compatibilita'
  tcgdexId    String? // id su TCGdex (es. "sv03.5"), la sorgente attuale di carte e prezzi
  slug        String
  name        String
  nameIt      String? // nome italiano da TCGdex (manca per qualche espansione)
  series      String?
  releaseDate DateTime?
  logoUrl     String?
  symbolUrl   String?
  cards       Card[]
  listings    Listing[]

  @@unique([gameId, slug])
  @@unique([gameId, externalId])
  @@unique([gameId, tcgdexId])
}

model Card {
  id         String    @id @default(cuid())
  setId      String
  set        CardSet   @relation(fields: [setId], references: [id])
  externalId String?   @unique
  number     String // numero nel set, es. "199/165"
  name       String
  rarity     String?
  supertype  String? // Pokémon, Trainer, Energy, Leader, Character...
  imageSmall String?
  imageLarge String?
  // Prezzi di riferimento Cardmarket (da TCGdex), in centesimi: aiutano a prezzare dall'admin.
  cmTrendCents   Int?
  cmAvgCents     Int?
  cmLowCents     Int?
  cmUrl          String?
  cmUpdatedAt    DateTime?
  syncedAt       DateTime? // ultimo scarico da TCGdex (per riprendere un import interrotto)
  listings   Listing[]

  @@unique([setId, number])
  @@index([name])
}

enum ListingKind {
  SINGLE
  SEALED
  GRADED
}

enum Condition {
  MINT
  NEAR_MINT
  EXCELLENT
  GOOD
  LIGHT_PLAYED
  PLAYED
  POOR
}

enum SealedType {
  BOOSTER_PACK
  BOOSTER_BOX
  ELITE_TRAINER_BOX
  COLLECTION_BOX
  TIN
  BUNDLE
  BLISTER
  BUILD_BATTLE
  OTHER
}

enum Grader {
  PSA
  BGS
  CGC
  OTHER
}

model Listing {
  id         String      @id @default(cuid())
  kind       ListingKind
  gameId     String
  game       Game        @relation(fields: [gameId], references: [id])
  setId      String?
  set        CardSet?    @relation(fields: [setId], references: [id])
  cardId     String? // obbligatorio per SINGLE e GRADED
  card       Card?       @relation(fields: [cardId], references: [id])
  title      String // per i sigillati, es. "Booster Box Scarlatto e Violetto 151"
  language   String      @default("it") // it, en, ja...
  condition  Condition? // SINGLE
  sealedType SealedType? // SEALED
  grader     Grader? // GRADED
  grade      Decimal?    @db.Decimal(3, 1) // GRADED, es. 10 o 9.5
  certNumber String? // GRADED
  priceCents Int
  compareAtCents Int? // prezzo prima dello sconto, mostrato barrato ("Offerta")
  stock      Int         @default(0)
  images     String[] // foto reali (obbligatorie per le gradate)
  description String? // testo libero mostrato nella scheda (es. contenuto di un box)
  published  Boolean     @default(false)
  releaseDate DateTime? // preordine: data di uscita (se futura, il prodotto e' "In arrivo")
  orderItems OrderItem[]
  stockAlerts StockAlert[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([gameId, kind, published])
  @@index([cardId])
}

enum OrderStatus {
  PENDING
  PAID
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED
}

model Order {
  id              String      @id @default(cuid())
  email           String
  customerId      String? // cliente registrato (null per gli acquisti da ospite)
  customer        Customer?   @relation(fields: [customerId], references: [id], onDelete: SetNull)
  status          OrderStatus @default(PENDING)
  stripeSessionId String?     @unique
  subtotalCents   Int
  shippingCents   Int
  taxCents        Int         @default(0)
  totalCents      Int
  currency        String      @default("eur")
  shippingCountry String?
  shippingAddress Json?
  trackingNumber  String?
  locale          String      @default("it") // lingua del cliente per le email
  items           OrderItem[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  @@index([customerId])
}

// Cliente registrato: email + password (scrypt). Gli ordini fatti da ospite con la stessa email vengono collegati.
model Customer {
  id           String            @id @default(cuid())
  email        String            @unique
  passwordHash String
  name         String?
  locale       String            @default("it")
  orders       Order[]
  sessions     CustomerSession[]
  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
}

// Sessione di accesso: il cookie contiene solo il token casuale.
model CustomerSession {
  id         String   @id @default(cuid())
  token      String   @unique
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  @@index([customerId])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id])
  listingId      String
  listing        Listing @relation(fields: [listingId], references: [id])
  titleSnapshot  String
  unitPriceCents Int
  quantity       Int
}

// Zone di spedizione: Italia, UE, ecc.
model ShippingZone {
  id            String   @id @default(cuid())
  name          String
  countries     String[] // codici ISO, es. ["IT"]
  baseCents     Int
  freeOverCents Int?
}

// Iscritti alla newsletter (pop-up di benvenuto con codice sconto).
model Subscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  locale    String   @default("it")
  source    String   @default("popup")
  newReleases Boolean  @default(true) // vuole l'avviso delle nuove uscite
  interests   String[] @default([]) // slug dei giochi che seguono, es. ["pokemon", "one-piece"]
  createdAt DateTime @default(now())
}

// "Avvisami quando torna disponibile": una riga per email e prodotto, cancellata dopo l'invio.
model StockAlert {
  id        String    @id @default(cuid())
  email     String
  listingId String
  listing   Listing   @relation(fields: [listingId], references: [id], onDelete: Cascade)
  locale    String    @default("it")
  createdAt DateTime  @default(now())

  @@unique([email, listingId])
  @@index([listingId])
}

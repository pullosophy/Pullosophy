# Postgres (Supabase): connection pooler per l'app, connessione diretta per le migrazioni
DATABASE_URL="postgresql://postgres:password@localhost:5432/pullosophy"
DIRECT_URL="postgresql://postgres:password@localhost:5432/pullosophy"

# Facoltativa: alza i limiti della Pokémon TCG API
POKEMONTCG_API_KEY=""

# Password del pannello /admin
ADMIN_PASSWORD=""

# Stripe
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# URL pubblico del sito (usato per i link di ritorno da Stripe)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Dati fiscali mostrati nelle pagine legali e nel footer (opzionali: senza, compaiono segnaposto "[da completare]")
COMPANY_LEGAL_NAME=""
COMPANY_VAT=""
COMPANY_ADDRESS=""
COMPANY_EMAIL=""

# Caricamento foto dall'admin (Vercel → Storage → Create Database → Blob: la variabile viene aggiunta da sola)
BLOB_READ_WRITE_TOKEN=""

# Codice sconto di benvenuto (creato su Stripe al primo uso)
WELCOME_CODE="BENVENUTO10"
WELCOME_PERCENT="10"

# Email transazionali via Resend (conferma ordine, spedizione, codice di benvenuto).
# Senza chiave non si invia nulla. EMAIL_FROM richiede un dominio verificato su Resend;
# senza, si usa onboarding@resend.dev che consegna solo all'email del proprietario dell'account.
RESEND_API_KEY=""
EMAIL_FROM="Pullosophy <ordini@pullosophy.it>"

# Google Search Console: codice del meta tag "google-site-verification" (solo il valore content)
GOOGLE_SITE_VERIFICATION=""
